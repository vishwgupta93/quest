    <formulas>
        <name>age_calculation</name>
        <dataType>Number</dataType>
        <expression>IF( ISBLANK({!Date_of_Birth} ) , NULL ,
  IF( DATE( 2000 , MONTH( {!Date_of_Birth} ) , DAY( {!Date_of_Birth} ) ) &lt;= DATE( 2000 , MONTH( TODAY() ) , DAY( TODAY() ) ),
     YEAR (TODAY()) - YEAR ( {!Date_of_Birth} ),
     YEAR (TODAY()) - YEAR ( {!Date_of_Birth} ) -1 )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>age_validation</name>
        <dataType>Boolean</dataType>
        <expression>IF({!age_calculation}&lt;=VALUE({!Get_Product.Min_age__c}),TRUE,FALSE)</expression>
    </formulas>
    <formulas>
        <name>Checkbox_check_error</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Checkbox} = FALSE, TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>ErrorMessage</name>
        <dataType>String</dataType>
        <expression>IF({!Checkbox_check_error} = True, &apos; &apos;, {!$Label.Atena_Details_ErrorMsg})</expression>
    </formulas>
    <formulas>
        <name>gender_validation</name>
        <dataType>Boolean</dataType>
        <expression>IF(AND(TEXT({!Get_Product.Gender__c})&lt;&gt;{!Sex},
TEXT({!Get_Product.Gender__c})&lt;&gt;&quot;Both&quot;),
TRUE,FALSE)</expression>
    </formulas>
    <formulas>
        <description>Set to TRUE if the selected state is invalid based on the Excluded State codes field on the product object.</description>
        <name>Invalid_state_check</name>
        <dataType>Boolean</dataType>
        <expression>IF(INCLUDES({!Get_Product.Excluded_State_codes__c},&apos;State_stand_alone&apos;)=TRUE,TRUE,FALSE)</expression>
    </formulas>
