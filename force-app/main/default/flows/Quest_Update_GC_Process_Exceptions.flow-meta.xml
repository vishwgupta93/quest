    <decisions>
        <name>Check_If_captured_and_total_amount_are_Same</name>
        <label>Check If captured and total amount are Same</label>
        <locationX>1012</locationX>
        <locationY>1574</locationY>
        <defaultConnector>
            <targetReference>Reset_Capture_Amount</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Amounts_Match</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>TotalCapturedAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Evaluate_Process_Exception_And_Update.OrderSummary.GrandTotalAmount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TotalPendingAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Evaluate_Process_Exception_And_Update.OrderSummary.GrandTotalAmount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TotalPendingAmountWithGC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Evaluate_Process_Exception_And_Update.OrderSummary.GrandTotalAmount</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TotalPendingAmountWithGC</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Evaluate_Process_Exception_And_Update.OrderSummary.Service_Fee__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TotalPendingAmount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>SummaryTotalWithServiceFee</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Form_PE_Object_to_update</targetReference>
            </connector>
            <label>Amounts Match</label>
        </rules>
    </decisions>
