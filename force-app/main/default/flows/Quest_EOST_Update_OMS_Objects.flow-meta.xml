    <environments>Default</environments>
    <formulas>
        <name>AtHomeStatus</name>
        <dataType>String</dataType>
        <expression>IF(
    AND({!$Record.Kit_Detail__r.Type__c} = &apos;at_home&apos;, {!$Record.OMS_Status__c} = &apos;In Progress&apos;), 
    &apos;Sample Received&apos;, 
    IF(
        AND({!$Record.Kit_Detail__r.Type__c} = &apos;at_home&apos;, {!$Record.OMS_Status__c} = &apos;Results Ready&apos;,{!$Record.Hold_Cleared__c}), 
        &apos;Results Ready&apos;, 
        TEXT({!$Record.Kit_Detail__r.Lab_Status__c})
    )
)</expression>
    </formulas>
    <formulas>
        <name>CaseDescription</name>
        <dataType>String</dataType>
        <expression>{!$Record.Lab_Ref_Id__c} + &apos; :: &apos; + {!$Record.PID__c}</expression>
    </formulas>
    <formulas>
        <name>CaseSubject</name>
        <dataType>String</dataType>
        <expression>IF(OR(!{!IsValidPanelCode},ISNULL({!$Record.Lab_Ref_Id__c}), ISBLANK({!$Record.Lab_Ref_Id__c})),&apos;EOST payload contains unexpected panel code or LabRefId.&apos;,IF({!$Record.Is_Error__c}, &apos;Payload has key attribute errors. Please check&apos;,IF({!$Record.OMS_Status__c}=&apos;TNP&apos;,&apos;Payload has a test with TNP.&apos;,&apos;Payload has errors. Kindly address.&apos;)))</expression>
    </formulas>
    <formulas>
        <name>FHIRExternalID</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!$Record.Lab_Order__r.LabRefId_Override__c}),UPPER({!$Record.Lab_Order__r.LabRefId_Override__c}),UPPER({!$Record.Lab_Ref_Id__c}))+&apos;_&apos;+{!$Record.Accession_Number__c}</expression>
    </formulas>
    <formulas>
        <description>Outputs base panel code for adult LO or panel code with &quot;-min&quot; appended for minors LO</description>
        <name>fx_PanelCode</name>
        <dataType>String</dataType>
        <expression>IF(
NOT(ISBLANK({!$Record.Lab_Order__r.Minor_Last_Name__c})),
{!$Record.EOST_Test_Code__c}&amp;&quot;-min&quot;,
{!$Record.EOST_Test_Code__c}
)</expression>
    </formulas>
    <formulas>
        <name>GSSInProgressStatus</name>
        <dataType>String</dataType>
        <expression>IF(
    AND({!$Record.Kit_Detail__r.Type__c} = &apos;GSS&apos;, {!$Record.OMS_Status__c} = &apos;In Progress&apos;,{!$Record.Test_Event_Desc__c}=&apos;&apos;), 
    &apos;Sample Received&apos;, 
    IF(
       AND({!$Record.Kit_Detail__r.Type__c} = &apos;GSS&apos;, {!$Record.OMS_Status__c} = &apos;In Progress&apos;,UPPER({!$Record.Test_Event_Desc__c}) = &apos;DNAEXTRACTED&apos;), 
        
        &apos;DNA Extracted&apos;,
		&apos;DNA Analyzed&apos;
    )
)</expression>
    </formulas>
    <formulas>
        <name>GSSResultsReady</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!$Record.Kit_Detail__r.Type__c} = &apos;GSS&apos;,
        {!$Record.OMS_Status__c} = &apos;Results Ready&apos;,
        {!$Record.Order_Event_Desc__c} = &apos;report-received&apos;,
        {!$Record.Hold_Cleared__c}
    ), 
    &apos;Results Ready&apos;, 
TEXT({!$Record.Kit_Detail__r.Lab_Status__c})
)</expression>
    </formulas>
    <formulas>
        <name>GSSStatus</name>
        <dataType>String</dataType>
        <expression>IF({!$Record.OMS_Status__c} = &apos;In Progress&apos;, {!GSSInProgressStatus}, {!GSSResultsReady})</expression>
    </formulas>
    <formulas>
        <name>Status</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        {!$Record.OMS_Status__c} == &apos;Results Ready&apos;,
        {!$Record.Order_Status__c} == &apos;ResultedPartial&apos;,
{!TotalTest} == 1
    ),
    &apos;Partial Results Ready&apos;,
    IF(
            {!$Record.OMS_Status__c} == &apos;Partial Results Ready&apos; ,
        &apos;Partial Results Ready&apos;,
        IF(
            AND(
                {!$Record.OMS_Status__c} == &apos;Results Ready&apos;,
                {!$Record.Hold_Cleared__c}),
            &apos;Results Ready&apos;,
            IF(
                {!$Record.OMS_Status__c} == &apos;TNP&apos;,
                &apos;TNP&apos;,
                &apos;In Progress&apos;
            )
        )
    )
)</expression>
    </formulas>
    <formulas>
        <name>TotalTest</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Lab_Order__r.Total_Panels__c}</expression>
        <scale>2</scale>
    </formulas>
