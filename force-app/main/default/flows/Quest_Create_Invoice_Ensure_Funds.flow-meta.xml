    </formulas>
    <formulas>
        <name>Multicapture</name>
        <dataType>Boolean</dataType>
        <expression>IF(OR({!Get_Gateway_Id.paymentType__c} = &apos;klarna&apos;, {!Get_Gateway_Id.paymentType__c} = &apos;affirm&apos;,{!GCPaymentExists}), false, true)</expression>
