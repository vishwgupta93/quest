    <formulas>
        <name>CaptureAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!Multicapture}, {!Get_Fulfillment_Order.GrandTotalAmount},{!Get_Fulfillment_Order.OrderSummary.GrandTotalAmount}-{!GCAmount})</expression>
