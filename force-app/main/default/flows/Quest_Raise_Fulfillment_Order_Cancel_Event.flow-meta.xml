    </formulas>
    <formulas>
        <name>EventDefinition</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Status}, &apos;Cancelled&apos;), {!$Label.SFMC_Order_Cance_Event_Definition},
   IF(ISPICKVAL({!$Record.Status}, &apos;Expired&apos;), {!$Label.SFMC_Order_Expiry_Event_Definition}, {!$Label.SFMC_Order_PWN_Reject_Event_Definition}))</expression>
    </formulas>
    <formulas>
