    <decisions>
        <name>Lab_Order_or_Order_Summary</name>
        <label>Lab Order or Order Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Skip_Case</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Lab_Orders</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRecordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>$Label.SF_Lab_Order_Key_Prefix</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lab_Order</targetReference>
            </connector>
            <label>Lab Orders</label>
        </rules>
        <rules>
            <name>Fulfillment_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRecordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>0a3</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Fulfillment_Order</targetReference>
            </connector>
            <label>Fulfillment Order</label>
        </rules>
        <rules>
            <name>Order_Summary</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varRecordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>1Os</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Order_Summary</targetReference>
            </connector>
            <label>Order Summary</label>
        </rules>
    </decisions>
    <decisions>
        <name>Skip_Case</name>
        <label>Skip Case?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>What_Case_Record_Type_to_Get</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Not_Needed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>VarCase.Reason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Cancellation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VarCase.Reason</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancel / Appease - QA purpose</stringValue>
                </rightValue>
            </conditions>
            <label>Case Not Needed</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Case_Record_Type_to_Get</name>
