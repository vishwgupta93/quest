        <rules>
            <name>Partner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxPurchasedFrom_LO</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Other website or app</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Partner_Case_Record_Type</targetReference>
            </connector>
            <label>Partner</label>
        </rules>
    </decisions>
