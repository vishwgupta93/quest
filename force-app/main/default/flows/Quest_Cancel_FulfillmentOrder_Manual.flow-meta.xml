                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>CLOSED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Fulfillment_Order.StatusCategory</leftValueReference>
                <operator>NotEqualTo</operator>
