    <formulas>
        <name>AvailableCCAmount</name>
        <dataType>Currency</dataType>
        <expression>{!Get_CC_and_GC_Available_Amounts_to_Refund.CapturedAmount}-{!Get_CC_and_GC_Available_Amounts_to_Refund.RefundedAmount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CCAmountToDisplay</name>
        <dataType>Currency</dataType>
        <expression>IF(AND({!TotalRefund} &gt; {!AvailableGCAmount}, {!CCAmount} &gt; 0), {!TotalRefund} - {!AvailableGCAmount}, 0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FinalRefundWithGC</name>
        <dataType>Currency</dataType>
        <expression>{!Service_Fee}+{!GCAmountToDisplay}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>GCAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(ISPICKVAL({!Get_Fulfillment_Order.Status}, &apos;Pending Approval&apos;), {!Get_CC_and_GC_Available_Amounts_to_Refund.BalanceAmount}, {!Get_CC_and_GC_Available_Amounts_to_Refund.CapturedAmount}-{!Get_CC_and_GC_Available_Amounts_to_Refund.BalanceAmount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>GCAmountToDisplay</name>
        <dataType>Currency</dataType>
        <expression>IF({!TotalRefund}&lt;= {!AvailableGCAmount},{!TotalRefund}, {!AvailableGCAmount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>GCBalanceForPWNAvailable</name>
        <dataType>Currency</dataType>
        <expression>IF({!TotalRefund}&lt;= {!AvailableGCAmount},{!AvailableGCAmount}-{!TotalRefund},0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>GrandTotal</name>
        <dataType>Currency</dataType>
        <expression>{!Get_Fulfillment_Order.GrandTotalAmount}</expression>
        <scale>2</scale>
    </formulas>
