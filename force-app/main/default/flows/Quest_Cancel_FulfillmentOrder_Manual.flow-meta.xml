                <leftValueReference>Get_Fulfillment_Order.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Results Ready</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Fulfillment_Order.StatusCategory</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>REJECTED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CancelFO</targetReference>
            </connector>
            <label>Yes- Cancelable</label>
        </rules>
