        <locationX>50</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>EventDefinitionKey__c</field>
            <value>
                <elementReference>$Label.SFMC_Payment_capture_EventDefinition</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Event_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Event_Type__c</field>
            <value>
                <elementReference>$Label.SFMC_Payment_Capture_Event</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Order_Summary_Id__c</field>
            <value>
                <elementReference>$Record.ReferenceEntityId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Test_type__c</field>
            <value>
                <elementReference>Get_FO_For_Invoice.Record_Type_Name__c</elementReference>
            </value>
        </inputAssignments>
        <object>SFMC_Email_Event__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_FO_For_Invoice</name>
        <label>Get FO For Invoice</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Raise_SFMC_Payment_Failure_Event</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>InvoiceId</field>
            <operator>EqualTo</operator>
