 Revenue where Quest is the Merchant of Record (using our Stripe instance for payment)\n                                    </div>\n                                </td>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Salesforce OMS\">Salesforce OMS</div>\n                                </td>\n                            </tr>\n                            <tr>\n                                <th scope=\"row\">\n                                    <div class=\"slds-truncate\" title=\"PMoR Revenue\"><strong>PMoR Revenue</strong></div>\n                                </th>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Revenue where the Partner is the Merchant of Record (not using our Stripe instance for payment)\">\n                                        Revenue where the Partner is the Merchant of Record (not using our Stripe instance for payment)\n                                    </div>\n                                </td>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Salesforce OMS\">Salesforce OMS</div>\n                                </td>\n                            </tr>\n                            <tr>\n                                <th scope=\"row\">\n                                    <div class=\"slds-truncate\" title=\"Total Orders\"><strong>Total Orders</strong></div>\n                                </th>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Number of orders placed through our partners\">\n                                        Number of orders placed through our partners\n                                    </div>\n                                </td>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Salesforce OMS\">Salesforce OMS</div>\n                                </td>\n                            </tr>\n                            <tr>\n                                <th scope=\"row\">\n                                    <div class=\"slds-truncate\" title=\"Total Orders Completed\"><strong>Total Orders Completed</strong></div>\n                                </th>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Number of orders that are registered, scheduled, taken, and completed\">\n                                        Number of orders that are registered, scheduled, taken, and completed\n                                    </div>\n                                </td>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Salesforce OMS\">Salesforce OMS</div>\n                                </td>\n                            </tr>\n                            <tr>\n                                <th scope=\"row\">\n                                    <div class=\"slds-truncate\" title=\"Order Completion Rate\"><strong>Order Completion Rate</strong></div>\n                                </th>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Rate of orders that are completed\">\n                                        Rate of orders that are completed\n                                    </div>\n                                </td>\n                                <td>\n                                    <div class=\"slds-truncate\" title=\"Total Orders Completed / Total Orders\">\n                                        Total Orders Completed / Total Orders\n                                    </div>\n                                </td>\n                            </tr>\n                            <tr>\n                                <th scope=\"row\">\n             